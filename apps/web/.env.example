# Neon: sólo servidor. Usar la conexión pooled.
DATABASE_URL=

# Better Auth sobre Neon: sólo servidor.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
MONITOR_LEGAL_ALLOW_SIGN_UP=false

# Perfil inicial
MONITOR_LEGAL_OWNER_NAME=Agustín Gatti
MONITOR_LEGAL_STUDIO_NAME=Gatti Legales

# Modo demo local. En producción debe ser false.
MONITOR_LEGAL_DEMO=true

# Gmail SMTP con App Password; no se configura OAuth en este MVP.
EMAIL_USER=
EMAIL_PASS=
ALERT_EMAIL=

# Dispatch opcional de la sincronización PJN desde la web.
GITHUB_REPOSITORY=tobiasgatti02/monitor-legal
GITHUB_DISPATCH_TOKEN=

# Agente ampliado: aplicar migraciones y validar en entorno aislado antes de habilitar.
LEGAL_DURABLE_INGESTION=false
LEGAL_LIVE_FOLDER=false
LEGAL_FACT_EXTRACTION=false
LEGAL_DRAFTS=false
LEGAL_RESEARCH=false

# Credenciales actuales de servicio, exclusivamente servidor. No activar nuevos proveedores sin tarifa/ensayo.
LEGAL_AI_URL=
LEGAL_AI_KEY=
DATABASE_SCHEDULER_URL=
ALERT_CRON_KEY=
# Secreto independiente del cron de alertas; requiere el endpoint Node /api/internal/ingestion.
INGESTION_CRON_KEY=
# MEV / SCBA Notificaciones / voz / liquidaciones jurídicas no están activadas por estas flags.
