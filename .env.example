# Credenciales PJN - Usuario (local / ejemplo)
PJN_USER=
PJN_PASS=
PJN_USER_PJN=
PJN_PASS_PJN=
PJN_USER_MAZZARINI_PJN=
PJN_PASS_MAZZARINI_PJN=

# SMTP Gmail (recomendado App Password)
EMAIL_USER=
EMAIL_PASS=

# Destinatarios de alertas (opcional; en GitHub Actions se usan secrets por usuario)
ALERT_EMAIL=Gattilegales@gmail.com

# Configuracion scraper
PJN_HEADLESS=true
PJN_TIMEOUT_MS=45000
PJN_RETRIES=2
PJN_STATE_PATH=state_gatti.json
MONITOR_TENANT_ID=
PJN_CONNECTOR_ID=

# Escritura dual opcional en Neon. Los IDs deben existir y ser UUID.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_REQUIRED=false
PJN_SYNC_TRIGGER=MANUAL
MONITOR_JOB_ID=

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Perfil inicial
MONITOR_LEGAL_OWNER_NAME=Agustín Gatti
MONITOR_LEGAL_STUDIO_NAME=Gatti Legales

# NOTA: En GitHub Actions hay dos jobs separados:
# - monitor-gatti usa PJN_USER_GATTI / PJN_PASS_GATTI / ALERT_EMAIL_GATTI
# - monitor-mazzarini usa PJN_USER_MAZZARINI / PJN_PASS_MAZZARINI / ALERT_EMAIL_MAZZARINI
