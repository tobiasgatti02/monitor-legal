# Credenciales PJN - Usuario 1 (Gatti)
PJN_USER=
PJN_PASS=

# SMTP Gmail (recomendado App Password)
EMAIL_USER=
EMAIL_PASS=

# Destinatarios de alertas (opcional; se usan secrets POR USUARIO en GitHub Actions)
ALERT_EMAIL=Gattilegales@gmail.com

# Configuracion scraper
PJN_HEADLESS=true
PJN_TIMEOUT_MS=45000
PJN_RETRIES=2
PJN_STATE_PATH=state_gatti.json

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# NOTA: En GitHub Actions, se soportan multiples usuarios simultáneamente.
# Configurar en Settings > Secrets and variables > Actions:
# - PJN_USER_gatti / PJN_PASS_gatti / ALERT_EMAIL_gatti
# - PJN_USER_mazzarini / PJN_PASS_mazzarini / ALERT_EMAIL_mazzarini
# (El workflow iterará automaticamente sobre ambos con strategy.matrix)
